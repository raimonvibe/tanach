{
  "name": "tanach-reader",
  "version": "1.0.1",
  "description": "Tanach Reader — read the Jewish Bible online in Hebrew and English",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node src/server.js",
    "sefaria": "node src/scripts/sefaria-importer.js",
    "import:talmud": "node src/scripts/jewish-texts-importer.js talmud",
    "import:mishnah": "node src/scripts/jewish-texts-importer.js mishnah",
    "import:rambam": "node src/scripts/jewish-texts-importer.js rambam",
    "import:sefer-hamitzvot": "node src/scripts/import-sefer-hamitzvot.js",
    "check:missing": "node src/scripts/check-missing-texts.js",
    "import:all-texts": "node src/scripts/jewish-texts-importer.js all",
    "import:readings": "node src/scripts/import-readings-content.js",
    "fix:missing": "node src/scripts/fix-missing-content.js",
    "clean:invalid": "node src/scripts/clean-invalid-pages.js",
    "test": "jest"
  },
  "keywords": [
    "tanach",
    "bible",
    "hebrew",
    "jewish"
  ],
  "dependencies": {
    "@hebcal/core": "^5.10.1",
    "@hebcal/leyning": "^9.3.0",
    "express": "^4.19.2",
    "fs-extra": "^11.2.0",
    "lunr": "^2.3.9",
    "nodemon": "^3.1.1"
  },
  "devDependencies": {
    "vite": "^7.2.2"
  }
}
